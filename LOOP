#!/usr/bin/env bash
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
export PATH="$PWD/bin:$PATH"

prompt=$(cat <<'EOF'
Read all the new files added in commit b9343d784d95b3a92e998eed78f0c86cca63a205, and try to get the idea of what I'm looking for.

I'm sure the prompt contradicts itself and it surely incomplete, but I don't think we're looking for something difficult or complex here.

I think once we get the right primitives, it'll just WORK, and it'll be super fun to use and feel like old unix plus something like a bsd ports system plus 
something like bind mounts and/or a system where everything in the system lives in git but there's no more .

git directory anywhere, you just have different distros or branches or something that CAN provide the implementation of a given directory, and directories can 
also have local (and system wide) abilities that feel like cd'ing into a new repo with a Makefile and just hitting <tab>.

Not the makefiles for building C necessarily, I mean like the Makefiles where each make target is a one word name with a one line implementation.

Like what we were going for in the GEN and TWO files in here.

Also add lib/LD as the generic executor thing for arbitrary english that can be used in shebangs.

I think for now LD is probably just a usr/bin/env -s shebang with lordhavemercy -f, and then we can change /lib/LD to change the default executor strength 
system wide for all things that use the lord commands.

Implement all that.

Actually let's implement it by looping on the same prompt.

Whenever I run this prompt, however many times, I want you to:
1. Generate a list of questions to ask me, to try to narrow down the most important points you think you need to know before you can implement the whole thing.
2. Then store the answers to those questions in etc/answers/un/%02d-$name where the $name is a summary of what you asked and learned in that round.
3. Then make sure there's a top level un command in the bin of this directory, make sure its portable and only uses env vars and writes its own config
   to ~/.config/un/ or whatever (the analogue of etc if we're not a whole os yet), and let me explore the (simple!) command, and the much more flexible
   set of possibilities in the system myself. Also maybe instead of ATPATH it should be something else. But it should feel like the shell and unix.
   Self contained executable, can be moved anywhere else as long as it's in $PATH, can add config files but don't need to, has a man page that installs
   to the first writable place in MANPATH by default, whatever, you get it, don't overfit to the prompt. Ask questions.
4. I have to run, but generate the questions, then ask me interactively, with pre-generated multiple choice answers plus the option to type something too,
   then let's loop on that until the system is good.

Go!
EOF
)

questions=$({
    printf '%s\n\n' "$prompt"
    cat <<'EOF'
This call only prepares the next interview. Read the previous rounds in
etc/answers/un and inspect what un already implements before choosing what to ask.
Return only the interview in this format, with no Markdown or extra text.
The first line is a short lowercase hyphenated slug summarizing the round.
Then give one to three lines, each with exactly four tab-separated fields:
the question, the recommended choice, and two other choices.
EOF
} | lordhavemercy -i --verbose)

transcript=
{
    IFS= read -r topic <&3
    if [[ ! $topic =~ ^[a-z0-9]+(-[a-z0-9]+)*$ || ${#topic} -gt 64 ]]; then
        printf 'LOOP: expected a short round name followed by questions\n' >&2
        exit 1
    fi
    while IFS=$'\t' read -r question first second third extra <&3; do
        if [[ -z $question || -z $first || -z $second || -z $third || -n $extra ]]; then
            printf 'LOOP: expected a question with three choices\n' >&2
            exit 1
        fi
        printf '\n%s\n  1. %s (recommended)\n  2. %s\n  3. %s\n' \
            "$question" "$first" "$second" "$third" >&2
        while :; do
            printf 'Enter a number or type your own answer. ' >&2
            IFS= read -r reply || exit 1
            [[ -n $reply ]] && break
        done
        case $reply in
            1) reply=$first ;;
            2) reply=$second ;;
            3) reply=$third ;;
        esac
        printf -v transcript '%s%s\n%s\n\n' "$transcript" "$question" "$reply"
    done
} 3<<< "$questions"

if [[ -z $transcript ]]; then
    printf 'LOOP: no questions received\n' >&2
    exit 1
fi

answers=etc/answers/un
mkdir -p -- "$answers"
round=1
for path in "$answers"/[0-9][0-9]*-*; do
    number=${path##*/}
    number=${number%%-*}
    if [[ $number =~ ^[0-9]{2,}$ ]] && ((10#$number >= round)); then
        round=$((10#$number + 1))
    fi
done
printf -v record '%s/%02d-%s' "$answers" "$round" "$topic"
(set -o noclobber; printf '%s' "$transcript" > "$record")

{
    printf '%s\n\n' "$prompt"
    printf 'The interview is complete for this round. Read the answers already saved in %s.\n' "$record"
    printf '%s\n' 'Use them to take the next small implementation step and verify it.'
} | lordhavemercy -f --verbose
