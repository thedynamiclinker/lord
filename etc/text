# etc/text

etc/skel
edm     unix

################
### Headings ###
################

# Heading format
#
# Default is do
# what this file
# does, and the
# syntax below
# is defined by
# that default.
# Write your own
# and it should
# just work.

hns    default

hns:
    a = "### %s ###"
    b = "#"*len(a)
    c = f"{b}\n{a}\n{b}\n"
    return c

