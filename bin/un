#!/usr/bin/env python3
import errno
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile


HELP = """usage: un [-C DIR] [list | NAME [ARG ...]]
       un [-C DIR] run NAME [ARG ...]
       un [-C DIR] show [NAME]
       un [-C DIR] new [DIR]
       un [-C DIR] providers | open [PROVIDER] | switch PROVIDER | close
       un [-C DIR] {dn | up} [NAME ...]
       dn [NAME ...] | up [NAME ...]
       un export REPO REF DIR
       un path [PATHLIST]
       un completion | install-man [MANPATH-DIR]
"""

TRANSFER_HELP = {
    "dn": (
        "usage: dn [--] [NAME ...]\nList provider entries, or copy the named entries down.\n"
        "In Bash, load Tab completion with: source <(un completion)"
    ),
    "up": "usage: up [--] [NAME ...]\nUpdate entries already in the provider, or send the named entries up.",
}
RESERVED = {".git", "..."}

COMPLETION = r'''_un() {
    local i=1 cur=${COMP_WORDS[COMP_CWORD]} executable=${COMP_WORDS[0]} word
    local -a dir=()
    COMPREPLY=()
    if [[ ${COMP_WORDS[1]} == -C ]]; then
        if ((COMP_CWORD == 2)); then
            while IFS= read -r word; do COMPREPLY+=("$word"); done < <(compgen -d -- "$cur")
            return
        fi
        dir=(-C "${COMP_WORDS[2]}")
        i=3
    fi
    if ((COMP_CWORD == i)); then
        while IFS= read -r word; do
            [[ $word == "$cur"* ]] && COMPREPLY+=("$word")
        done < <(printf '%s\n' list run show new nu providers open switch close dn up export path completion install-man; "$executable" "${dir[@]}" list 2>/dev/null)
    elif [[ ${COMP_WORDS[i]} == dn ]]; then
        _un_dn "$executable" "${dir[@]}" dn
    elif ((COMP_CWORD == i + 1)); then
        case ${COMP_WORDS[i]} in
            run|show) set -- list ;;
            open|switch) set -- providers ;;
            *) return ;;
        esac
        while IFS= read -r word; do
            if [[ $word == "$cur"* || ( $1 == providers && ${word##*/} == "$cur"* ) ]]; then
                COMPREPLY+=("$word")
            fi
        done < <("$executable" "${dir[@]}" "$1" 2>/dev/null)
    fi
}
_un_dn() {
    local cur=${COMP_WORDS[COMP_CWORD]} word
    COMPREPLY=()
    compopt -o filenames
    while IFS= read -r word; do
        [[ $word == "$cur"* ]] && COMPREPLY+=("$word")
    done < <("$@" 2>/dev/null)
}
_dn() { _un_dn "${COMP_WORDS[0]}"; }
complete -F _un un
complete -F _dn dn
'''

MAN = r'''.TH UN 1
.SH NAME
un, dn, up \- explore and exchange files with provider directories
.SH SYNOPSIS
.B un
.RI [ \-C\ dir ]
.RI [ command\  [ arg ...]]
.br
.B dn
.RI [ name\  ...]
.br
.B up
.RI [ name\  ...]
.SH DESCRIPTION
Use ordinary Makefiles for fixed actions. Put commands that accept arguments
on PATH as executables named un-name, then run them with
.BR "un name [arg ...]" .
An English program can use the shebang
.B "#!/usr/bin/env LD"
when LD is on PATH.
.PP
Each provider is a directory tree. Set
.B UNROOT
to match subdirectories against the same relative path in each provider.
With UNROOT unset, each provider maps directly to the current directory.
.SH COMMANDS
.TP
.B list
List executable un-name extensions on PATH. This is the default.
.TP
.BI "run " "name [arg ...]"
Run a PATH extension, including one that shares a built-in name.
.TP
.BI "show [" "name" ]"
Print the executable selected for a command, or all extensions and their
paths if no name is given.
.TP
.BI "new [" "dir" ]
Create a directory. The alias is
.BR nu .
With no directory, use the current one.
.TP
.B providers
List provider roots with a tree for the current directory.
.TP
.BI "open [" "provider" ]
Create a symlink named ... to a provider's directory. Use the first provider
with a matching tree by default, or name a provider by basename or path.
.TP
.BI "switch " provider
Point ... at a different provider's directory.
.TP
.B close
Remove the ... symlink. The name ... is reserved for this link.
.TP
.BI "dn [" "name ...]"
List the provider's entries or copy the named entries into the current
directory. The open ... tree takes precedence over the first matching
provider on UNPATH. In Bash, press Tab after dn to see those names.
.TP
.BI "up [" "name ...]"
Send local entries back to the same provider. With no names, update paths
that already exist in the provider. Give names to publish new entries.
.PP
The default transfers use rsync, skip .git and ... at every level, and
keep files missing from the source. Names are entries in the current
directory. Use \fB--\fR before a name that starts with a hyphen.
.TP
.BI "export " "repo ref dir"
Export a branch, tag, or commit from a local Git repository into a new
directory. The result is an ordinary provider tree without Git metadata.
Add its path to UNPATH to use it.
.TP
.BI "path [" "pathlist" ]
Print the effective provider path, or save a colon-separated path for future
invocations. An empty path skips provider path lookup.
.TP
.B completion
Print Bash completion code for un and dn. Load it with
.BR "source <(un completion)" .
.TP
.BI "install-man [" "manpath-dir" ]
Install this page under man1 in the first writable directory in MANPATH.
With no MANPATH entries, use $XDG_DATA_HOME/man or ~/.local/share/man.
An explicit directory overrides MANPATH.
.SH ENVIRONMENT
.TP
.B UNPATH
Colon-separated provider roots, like PATH. An empty value skips path lookup.
When this variable is unset, use the path file in $XDG_CONFIG_HOME/un
or ~/.config/un if it exists. Use absolute paths to keep the same providers
when changing directories.
.TP
.B UNROOT
Root from which provider-relative paths are measured.
.TP
.B UN_SYNC
Executable to use in place of the default sync. It receives the action
(list, dn, or up), the absolute local directory, the absolute provider
directory, and any entry names as separate arguments. For list, print one
name per line. For up with no names, update previously provided entries.
.SH EXAMPLES
.nf
un new work
mkdir -p work/doc base/doc
printf 'hello\en' > base/doc/README
export UNROOT="$PWD/work" UNPATH="$PWD/base"
cd work/doc
un open
ls .../
dn
dn README
$EDITOR README
up README
un close
.fi
.PP
Use two branches of a bare repository as alternative providers.
.nf
un export "$HOME/src/world.git" main stable
un export "$HOME/src/world.git" next next
export UNROOT="$PWD/work" UNPATH="$PWD/stable:$PWD/next"
un -C work/doc providers
un -C work/doc open stable
un -C work/doc switch next
.fi
'''


def user_dir(variable, fallback):
    value = os.environ.get(variable, "")
    if os.path.isabs(value):
        return Path(value)
    home = os.environ.get("HOME", "")
    if os.path.isabs(home):
        return Path(home) / fallback
    return None


def path_config():
    config = user_dir("XDG_CONFIG_HOME", ".config")
    return config / "un/path" if config else None


def provider_path():
    if "UNPATH" in os.environ:
        return os.environ["UNPATH"]
    config = path_config()
    if config is not None:
        try:
            return config.read_text(encoding="utf-8").rstrip("\n")
        except FileNotFoundError:
            pass
    return ""


def write_file(path, contents):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".un-", dir=path.parent) as temp:
        draft = Path(temp) / path.name
        draft.write_text(contents, encoding="utf-8")
        draft.replace(path)


def provider_trees(cwd):
    root = os.environ.get("UNROOT")
    root = Path(root).resolve() if root else cwd
    try:
        relative = cwd.relative_to(root)
    except ValueError:
        raise ValueError(f"{cwd} is outside UNROOT ({root})") from None
    roots = dict.fromkeys(Path(p).absolute() for p in provider_path().split(":") if p)
    for base in roots:
        tree = base / relative
        if tree.is_dir():
            yield base, tree


def extensions():
    commands = {}
    for directory in os.get_exec_path():
        for executable in Path(directory).glob("un-?*"):
            if executable.is_file() and os.access(executable, os.X_OK):
                commands.setdefault(executable.name[3:], executable.absolute())
    return commands


def link_target(link):
    try:
        return Path(os.readlink(link))
    except OSError as error:
        if error.errno in (errno.ENOENT, errno.EINVAL):
            return None
        raise


def open_tree(link, trees, provider, switch):
    opened = link_target(link)
    if opened is not None and provider is None:
        return
    if opened is None and link.exists():
        raise ValueError(f"{link} already exists")
    chosen = Path(provider).absolute() if provider is not None else None
    for base, tree in trees:
        if provider is None or provider == base.name or chosen == base:
            if tree == opened:
                return
            if opened is None:
                link.symlink_to(tree, target_is_directory=True)
            elif switch:
                with tempfile.TemporaryDirectory(prefix=".un-", dir=link.parent) as temp:
                    draft = Path(temp) / "..."
                    draft.symlink_to(tree, target_is_directory=True)
                    draft.replace(link)
            else:
                raise ValueError("directory is open; use un switch PROVIDER")
            return
    raise ValueError(f"no provider has this directory{f' ({provider})' if provider else ''}")


def sync_provider(cwd):
    opened = link_target(cwd / "...")
    if opened is not None:
        tree = cwd / opened
        if not tree.is_dir():
            raise ValueError(f"open provider does not exist ({tree})")
        return tree.resolve()
    for _, tree in provider_trees(cwd):
        return tree.resolve()
    raise ValueError("no provider has this directory; set UNPATH or use un path")


def entries(directory):
    return sorted(entry.name for entry in directory.iterdir() if entry.name not in RESERVED)


def transfer(command, args):
    if args in (["-h"], ["--help"]):
        print(TRANSFER_HELP[command])
        print("Uses the open ... tree or the first matching provider. Set providers with un path.")
        return 0
    if args[:1] == ["--"]:
        args = args[1:]
    elif any(name.startswith("-") for name in args):
        print(TRANSFER_HELP[command], file=sys.stderr)
        return 2
    # Bash may append a slash when a completion is already a local directory.
    args = [name.rstrip("/") for name in args]
    for name in args:
        if name in RESERVED or name in ("", ".", "..") or "/" in name:
            raise ValueError(f"expected a file or directory name, got {name!r}")

    local = Path.cwd()
    high = sync_provider(local)
    action = "list" if command == "dn" and not args else command
    backend = os.environ.get("UN_SYNC")
    if backend:
        os.execvp(backend, [backend, action, str(local), str(high), *args])
    if action == "list":
        for name in entries(high):
            if "\n" not in name:
                print(name)
        return 0

    if local == high:
        raise ValueError("local and provider are the same directory")
    source, destination = (high, local) if action == "dn" else (local, high)
    names = args or entries(source)
    for outer, inner in ((local, high), (high, local)):
        if outer in inner.parents:
            nested = inner.relative_to(outer).parts[0]
            if nested in args:
                raise ValueError(f"{nested!r} contains the other sync directory")
            names = [name for name in names if name != nested]
    for name in args:
        if not os.path.lexists(source / name):
            raise FileNotFoundError(errno.ENOENT, "no such entry", source / name)
    if names:
        options = ["-ar", "--checksum", "--exclude=.git", "--exclude=...", "--from0", "--files-from=-"]
        if not args:
            options.append("--existing")
        subprocess.run(
            ["rsync", *options, "--", source, destination],
            input=b"".join(os.fsencode(name) + b"\0" for name in names), check=True,
        )
    return 0


def export_tree(repository, ref, destination):
    destination = Path(destination).absolute()
    if os.path.lexists(destination):
        raise FileExistsError(errno.EEXIST, "destination already exists", destination)
    with tempfile.TemporaryDirectory(prefix=".un-", dir=destination.parent) as temp:
        archive = Path(temp) / "tree.tar"
        tree = Path(temp) / "tree"
        tree.mkdir()
        subprocess.run(
            ["git", "-C", repository, "archive", "--format=tar", f"--output={archive}", "--", ref],
            check=True,
        )
        subprocess.run(["tar", "-xf", archive, "-C", tree], check=True)
        # Claim the name in case another export completed while Git was running.
        destination.mkdir()
        try:
            tree.replace(destination)
        except OSError:
            destination.rmdir()
            raise


def install_man(destination):
    if destination is None:
        places = [Path(p) for p in os.environ.get("MANPATH", "").split(":") if p]
        if not places:
            default = user_dir("XDG_DATA_HOME", ".local/share")
            if default:
                places = [default / "man"]
    else:
        places = [Path(destination)]
    for place in places:
        page = place / "man1/un.1"
        try:
            write_file(page, MAN)
        except OSError:
            if destination is not None:
                raise
        else:
            print(page)
            return
    raise ValueError("no writable MANPATH directory")


def usage():
    print(HELP, end="", file=sys.stderr)
    return 2


def main(args):
    if args[:1] == ["-C"]:
        if len(args) < 2:
            return usage()
        os.chdir(args[1])
        args = args[2:]
    command, *args = args or ["list"]
    if command in ("-h", "--help"):
        print(HELP, end="")
    elif command == "completion" and not args:
        print(COMPLETION, end="")
    elif command == "install-man" and len(args) <= 1:
        install_man(next(iter(args), None))
    elif command in ("new", "nu") and len(args) <= 1:
        Path(next(iter(args), ".")).mkdir(parents=True, exist_ok=True)
    elif command in ("dn", "up"):
        return transfer(command, args)
    elif command == "export":
        if len(args) != 3:
            return usage()
        export_tree(*args)
    elif command == "path" and len(args) <= 1:
        if not args:
            print(provider_path())
        else:
            config = path_config()
            if config is None:
                raise ValueError("set XDG_CONFIG_HOME or HOME to an absolute path")
            if "\n" in args[0] or "\r" in args[0]:
                raise ValueError("provider path must fit on one line")
            write_file(config, args[0] + "\n")
    elif command in ("list", "completion", "install-man", "new", "nu", "path") and args:
        return usage()
    else:
        cwd = Path.cwd()
        link = cwd / "..."
        if command == "close":
            if args:
                return usage()
            if link_target(link) is not None:
                try:
                    link.unlink()
                except FileNotFoundError:
                    pass
            elif link.exists():
                raise ValueError(f"{link} is not a symlink")
        elif command in ("open", "switch", "providers"):
            if not {"open": len(args) <= 1, "switch": len(args) == 1, "providers": not args}[command]:
                return usage()
            trees = provider_trees(cwd)
            if command == "providers":
                for base, _ in trees:
                    print(base)
            else:
                open_tree(link, trees, next(iter(args), None), command == "switch")
        else:
            if (command == "run" and not args) or (command == "show" and len(args) > 1):
                return usage()
            if command == "list":
                for name in sorted(extensions()):
                    print(name)
            elif command == "show" and not args:
                commands = extensions()
                for name in sorted(commands):
                    print(f"{name}: {commands[name]}")
            else:
                name, *arguments = args if command in ("run", "show") else [command, *args]
                executable = shutil.which(f"un-{name}") if name and "/" not in name else None
                if executable:
                    if command == "show":
                        print(f"{name}: {Path(executable).absolute()}")
                        return 0
                    os.execv(executable, [f"un-{name}", *arguments])
                print(f"un: unknown command: {name}", file=sys.stderr)
                return 127
    return 0


if __name__ == "__main__":
    invoked_as = Path(sys.argv[0]).name
    args = sys.argv[1:]
    if invoked_as in TRANSFER_HELP:
        args = [invoked_as, *args]
    try:
        sys.exit(main(args))
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
    except (OSError, ValueError) as error:
        sys.exit(f"{invoked_as}: {error}")
